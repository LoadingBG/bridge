{
  "name": "ФМИ",

  "conventions": {
    "high-card-points": {
      "title": "Точки от оньори",
      "description": [
        "Използват се за оценка на ръката. Точки се приписват на следните карти:\nА - 4\tK - 3\tQ - 2\tJ - 1\nВсички останали карти не носят точки. Накрая всичките точки се събират."
      ]
    },
    "barrage": {
      "title": "Бараж",
      "description": [
        "Слаба ръка с дълга боя. Обявява се, за да спре разговора на противниците.\nБараж се обявява на минимум 6 карти от боята, като се открива на второ ниво. Всяка допълнителна карта от боята позволява бараж от по-високо ниво - например седморна боя може да се обяви на трето ниво."
      ]
    },
    "takeout-double": {
      "title": "Информативна (тейкаут) контра",
      "description": [
        "Добра ръка с липса (сек или шикан) на контрираната боя. Казва на съотборника да обяви хубава за него боя на базата, че контрата му обещава подкрепа във всяка друга боя."
      ]
    },
    "stayman": {
      "title": "Стеймън (Stayman)",
      "description": [
        "По тази конвенция отговор ",
        {
          "type": "tile",
          "number": 2,
          "suit": "CLUB"
        },
        " на ",
        {
          "type": "tile",
          "number": 1,
          "suit": "NO_TRUMP"
        },
        " е запитване за четвърти мажор. Ако и двамата съотборници имат еднакъв мажор, могат да играят на боята вместо на без коз."
      ]
    },
    "jacoby-transfer": {
      "title": "Трансфер Якоби",
      "description": [
        "Показва дължина в следващата по поредност боя. Обявяване на пика е трансфер за спатии.\nБез коз е силна обява. По тази причина безкозовата ръка е хубаво да се държи скрита. Затова се обявява предишната боя - така играчът със силната ръка може да обяви игралната боя и да задържи ръката си скрита."
      ]
    }
  },

  "nonsystemicBid": {
    "hcp": "-",
    "description": [
      "Извънсистемно обявление"
    ]
  },

